{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FinderRemoteJob",
  "version": "0.1.0",
  "identifier": "com.finderremotejob.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "FinderRemoteJob",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Encuentra vacantes remotas, adapta tu CV a cada una y lleva el seguimiento.",
    "longDescription": "FinderRemoteJob busca vacantes remotas en varios portales, mide qué tanto encaja cada una con tu CV, lo adapta sin inventar datos y te ayuda a seguir tus postulaciones. Tus datos se quedan en tu computadora.",
    "license": "MIT OR Apache-2.0",
    "windows": {
      "nsis": {
        "languages": [
          "Spanish",
          "English"
        ],
        "installMode": "currentUser"
      }
    }
  },
  "mainBinaryName": "finder-remote-job"
}
