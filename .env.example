# Copia este archivo como .env y ajusta lo que necesites. .env está excluido de git.
# Sin ninguna variable, todo usa Ollama local (http://localhost:11434) con qwen3:8b.

# --- IA local (Ollama u otro servidor compatible con OpenAI) ---
# FRJ_LOCAL_URL=http://localhost:11434/v1
# FRJ_LOCAL_MODEL=qwen3:8b
# FRJ_EMBED_MODEL=bge-m3

# --- Redactor de CV y cartas: local | anthropic | openai ---
# Si hay ANTHROPIC_API_KEY, el redactor por defecto es Claude.
# FRJ_WRITER=local

# --- Claude (Anthropic) ---
# ANTHROPIC_API_KEY=sk-ant-...
# FRJ_ANTHROPIC_MODEL=claude-opus-5-5
# FRJ_ANTHROPIC_EFFORT=medium   # low | medium | high | xhigh | max (más alto = mejor y más caro)

# --- Otro proveedor compatible con OpenAI (OpenAI, Gemini, Groq, OpenRouter) ---
# FRJ_OPENAI_URL=https://api.openai.com/v1
# FRJ_OPENAI_API_KEY=...
# FRJ_OPENAI_MODEL=...
