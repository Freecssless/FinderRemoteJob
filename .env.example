# Opcional: lo mismo se configura desde la pantalla Ajustes de la app (las claves van al llavero
# del sistema). Lo que pongas aquí manda sobre Ajustes. Copia este archivo como .env; .env está excluido de git.
# Sin ninguna variable ni ajuste, todo usa Ollama local (http://localhost:11434) con qwen3:8b.

# --- IA local (Ollama u otro servidor compatible con OpenAI) ---
# FRJ_LOCAL_URL=http://localhost:11434/v1
# FRJ_LOCAL_MODEL=qwen3:8b
# FRJ_EMBED_MODEL=bge-m3

# --- Redactor de CV y cartas: local | anthropic | openai ---
# Si hay ANTHROPIC_API_KEY, el redactor por defecto es Claude.
# FRJ_WRITER=local

# --- Claude (Anthropic) ---
# ANTHROPIC_API_KEY=sk-ant-...
# FRJ_ANTHROPIC_MODEL=claude-opus-5-5
# FRJ_ANTHROPIC_EFFORT=medium   # low | medium | high | xhigh | max (más alto = mejor y más caro)
# FRJ_ANTHROPIC_PRICE_IN=...    # USD por millón de tokens; solo para el costo estimado
# FRJ_ANTHROPIC_PRICE_OUT=...

# --- Otro proveedor compatible con OpenAI (OpenAI, Gemini, Groq, OpenRouter) ---
# FRJ_OPENAI_URL=https://api.openai.com/v1
# FRJ_OPENAI_API_KEY=...
# FRJ_OPENAI_MODEL=...
# FRJ_OPENAI_PRICE_IN=...
# FRJ_OPENAI_PRICE_OUT=...

# --- Fuentes de vacantes con clave (opcionales; también en Ajustes, las claves van al llavero) ---
# FRJ_ADZUNA_APP_ID=...
# FRJ_ADZUNA_APP_KEY=...
# FRJ_ADZUNA_COUNTRY=mx
# FRJ_JOOBLE_KEY=...            # la gratuita tiene 500 consultas en total: se usa una vez al día
# FRJ_JOOBLE_DOMAIN=mx.jooble.org

# --- Alertas por correo (IMAP; también en Ajustes, la contraseña va al llavero) ---
# FRJ_IMAP_HOST=imap.gmail.com
# FRJ_IMAP_PORT=993
# FRJ_IMAP_USER=tu@correo.com
# FRJ_IMAP_PASSWORD=...         # contraseña de aplicación, no la de tu cuenta
